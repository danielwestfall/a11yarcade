{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quiz-game.local/schema/quiz-question.schema.json",
  "title": "Quiz Question (CPACC, WAS, or ADS)",
  "description": "One traceable CPACC, WAS, or ADS true/false or single-answer multiple-choice item.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "certification_id",
    "domain_id",
    "section_id",
    "concept_id",
    "type",
    "cognitive_level",
    "difficulty",
    "stem",
    "answer",
    "explanation",
    "source_refs",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "certification_id": {
      "enum": [
        "CPACC",
        "WAS",
        "ADS"
      ]
    },
    "domain_id": {
      "type": "string",
      "pattern": "^(CPACC|WAS|ADS)-D[1-5]$"
    },
    "section_id": {
      "type": "string",
      "minLength": 1
    },
    "subsection_id": {
      "type": "string"
    },
    "type": {
      "enum": [
        "true_false",
        "multiple_choice"
      ]
    },
    "cognitive_level": {
      "enum": [
        "recall",
        "comprehension",
        "application",
        "analysis"
      ]
    },
    "difficulty": {
      "enum": [
        "easy",
        "medium",
        "hard"
      ]
    },
    "stem": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-D]$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 2,
      "maxItems": 4,
      "uniqueItems": true
    },
    "answer": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "pattern": "^[A-D]$"
        }
      ]
    },
    "explanation": {
      "type": "string",
      "minLength": 1
    },
    "distractor_rationales": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "locator",
          "role"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "scope",
              "support",
              "example"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri-reference"
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "jurisdiction": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "approved",
        "retired"
      ]
    },
    "reviewed_at": {
      "type": "string",
      "format": "date"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "concept_id": {
      "type": "string",
      "minLength": 1
    },
    "variant_group_id": {
      "type": "string",
      "minLength": 1
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "variant_strategy": {
      "enum": [
        "new_context",
        "different_reasoning",
        "misconception_check",
        "format_shift",
        "difficulty_progression"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "true_false"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "options": false,
          "answer": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "multiple_choice"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "options"
        ],
        "properties": {
          "answer": {
            "type": "string",
            "pattern": "^[A-D]$"
          }
        }
      }
    }
  ]
}
